
# Terraform working directory
**/.terraform/*

# Terraform state files
**/terraform.tfstate
**/terraform.tfstate.*
*.tfstate
*.tfstate.*

# Variable files (may contain sensitive values)
**/*.tfvars
**/*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local CLI configuration
.terraformrc
terraform.rc

